{
  "name": "omp-viewer",
  "version": "0.1.0",
  "description": "Live cross-session dashboard and todo tracker for oh-my-pi (omp). Shows every locally running omp session, its status, and its todo list in a small popup window.",
  "type": "module",
  "main": "dist/extension.js",
  "license": "MIT",
  "keywords": [
    "omp",
    "oh-my-pi",
    "extension",
    "dashboard"
  ],
  "omp": {
    "extensions": [
      "dist/extension.js"
    ]
  },
  "pi": {
    "extensions": [
      "dist/extension.js"
    ]
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.1.14",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
